# CurseForge API key. Only needed to check CurseForge mods.
# Leave it empty for a Modrinth-only list.
# Request a CurseForge API key at https://console.curseforge.com/
CF_API_KEY=

# Where `python web.py` listens.
# Only the development server reads these; under gunicorn the -b flag decides.
# Keep 127.0.0.1 unless a proxy sits in front.
HOST=127.0.0.1
PORT=5000

# CLI only. Any non-empty value (e.g. 1) turns off the coloured verdict.
# Empty keeps colour on. Colour is also dropped automatically when piped.
NO_COLOR=
